{
  "deno.enable": true,
  "deno.lint": true,
  "deno.unstable": true,
  
  // Esta é a parte mais importante:
  // Diz ao VSCode para SÓ usar o Deno nesta pasta.
  "deno.enablePaths": [
    "supabase/functions"
  ],
  
  // Isso impede o TypeScript padrão do VSCode
  // de tentar validar os arquivos do Deno.
  "typescript.validate.enable": false
}